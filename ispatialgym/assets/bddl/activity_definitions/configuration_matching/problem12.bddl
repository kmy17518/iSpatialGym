(define (problem configuration_matching-12)
    (:domain ispatialgym)
    (:alias configuration_matching-articulation_close_small_scale-laptop-breakfast_table)

    ; ground_isg 2.0.0: configuration_matching-articulation_close_small_scale-laptop-breakfast_table (configuration_matching/articulation_close_small_scale.iddl; configuration_matching-articulation_close_small_scale#03~T1/representative)
    ; Configuration matching - articulation (small-scale, close). Spawned articulated object on the support, one joint open
    ; at q_init in S -> closed limit. Handle arm + brace arm (brace computed geometrically); root pose measured. Joint from
    ; the customs list (roles.target.joint / handle_key).

    (:objects
        laptop.n.01_1 - laptop.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (open laptop.n.01_1)
        (ontop laptop.n.01_1 breakfast_table.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (open ?laptop.n.01_1))
            (layout_reached ?laptop.n.01_1)
            (ontop ?laptop.n.01_1 ?breakfast_table.n.01_1)
            (not (grasped ?agent.n.01_1 ?laptop.n.01_1))
            (pose_settled ?laptop.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?laptop.n.01_1)
    )
)

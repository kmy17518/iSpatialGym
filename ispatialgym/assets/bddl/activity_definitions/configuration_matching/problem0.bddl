(define (problem configuration_matching-0)
    (:domain ispatialgym)

    (:alias block_design)

    ; toy_dice.n.01 (patterned cubes, 20 models) stands in for the interchangeable design blocks.
    (:objects
        toy_dice.n.01_1 toy_dice.n.01_2 toy_dice.n.01_3 toy_dice.n.01_4 - toy_dice.n.01
        table.n.02_1 - table.n.02
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:groups
        toy_dice.n.01_1 toy_dice.n.01_2 toy_dice.n.01_3 toy_dice.n.01_4 - blocks_group.n.01_1
    )

    (:init
        (ontop blocks_group.n.01_1 table.n.02_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    ; Binary success: every block is on the table, released, and the blocks reproduce the pictured relative
    ; arrangement (TRO groups["blocks_group.n.01_1"].layout_relations, shared block-to-slot assignment).
    (:goal
        (and
            (ontop ?blocks_group.n.01_1 ?table.n.02_1)
            (layout_reached ?blocks_group.n.01_1)
            (not (grasped ?agent.n.01_1 ?blocks_group.n.01_1))
            (pose_settled ?blocks_group.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    ; Non-gating: absolute placement of the blocks at the pictured slots (target_slots) is reported only.
    (:measure
        (pose_reached ?blocks_group.n.01_1)
    )
)

(define (problem configuration_matching-50)
    (:domain ispatialgym)
    (:variant configuration_matching-articulation_close_small_scale-carton-bottom_cabinet)

    ; ground_isg 2.0.0: configuration_matching-articulation_close_small_scale-carton-bottom_cabinet (configuration_matching/articulation_close_small_scale.iddl; configuration_matching-articulation_close_small_scale#02~T4/representative)
    ; Configuration matching - articulation (small-scale, close). Spawned articulated object on the support, one joint open
    ; at q_init in S -> closed limit. Handle arm + brace arm (brace computed geometrically); root pose measured. Joint from
    ; the customs list (roles.target.joint / handle_key).

    (:objects
        carton.n.02_1 - carton.n.02
        cabinet.n.01_1 - cabinet.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (open carton.n.02_1)
        (ontop carton.n.02_1 cabinet.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (open ?carton.n.02_1))
            (ontop ?carton.n.02_1 ?cabinet.n.01_1)
            (not (grasped ?agent.n.01_1 ?carton.n.02_1))
            (pose_settled ?carton.n.02_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?carton.n.02_1)
        (layout_reached ?carton.n.02_1)
    )
)

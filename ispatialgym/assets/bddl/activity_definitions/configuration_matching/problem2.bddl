(define (problem configuration_matching-2)
    (:domain ispatialgym)

    (:alias articulation)

    (:objects
        cabinet.n.01_1 - cabinet.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (open cabinet.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    ; Open -> closed. Binary success: the cabinet no longer counts as open, every non-fixed joint is within
    ; tolerance of its target (TRO articulation_targets["cabinet.n.01_1"]), and the cabinet is released.
    (:goal
        (and
            (not (open ?cabinet.n.01_1))
            (layout_reached ?cabinet.n.01_1)
            (not (grasped ?agent.n.01_1 ?cabinet.n.01_1))
            (pose_settled ?cabinet.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )
)

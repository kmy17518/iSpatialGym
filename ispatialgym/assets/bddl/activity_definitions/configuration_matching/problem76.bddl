(define (problem configuration_matching-76)
    (:domain ispatialgym)
    (:variant configuration_matching-block_design-block_4-conference_table)

    ; ground_isg 2.0.0: configuration_matching-block_design-block_4-conference_table (configuration_matching/block_design.iddl; configuration_matching-block_design#01~T2/representative)
    ; Configuration matching - block design. Four identical custom Kohs blocks (toy_dice/isgblk, ispatialgym-assets)
    ; scattered on the support; the goal is the pattern's top faces in a touching 2x2 grid anchored at the top-left block,
    ; aligned with the support edges, reached by the smallest rotation (yaw-align, one adjacent flip). layout_reached gates,
    ; pose_reached is measured. Group size and identical members are customs list parameters
    ; (generation.groups.targets: size 4, draw same_model); the blocks use the generic cube grasp set, so no library grasps
    ; are required.

    (:objects
        toy_dice.n.01_1 toy_dice.n.01_2 toy_dice.n.01_3 toy_dice.n.01_4 - toy_dice.n.01
        conference_table.n.01_1 - conference_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:groups
        toy_dice.n.01_1 toy_dice.n.01_2 toy_dice.n.01_3 toy_dice.n.01_4 - targets_group.n.01_1
    )

    (:init
        (ontop targets_group.n.01_1 conference_table.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?targets_group.n.01_1 ?conference_table.n.01_1)
            (layout_reached ?targets_group.n.01_1)
            (not (grasped ?agent.n.01_1 ?targets_group.n.01_1))
            (pose_settled ?targets_group.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?targets_group.n.01_1)
    )
)

(define (problem configuration_matching-22)
    (:domain ispatialgym)
    (:alias configuration_matching-articulation_open_small_scale-hinged_jar-breakfast_table)

    ; ground_isg 2.0.0 2026-09-15: configuration_matching-articulation_open_small_scale-hinged_jar-breakfast_table (configuration_matching/articulation_open_small_scale.iddl; configuration_matching-articulation_open_small_scale#02/representative)
    ; Configuration matching - articulation (small-scale, open). Spawned articulated object (toolbox, carton, hinged jar) on
    ; the support (floor for objects taller than 0.6 m), facing the robot; closed -> open to q_goal in S. Handle arm + brace
    ; arm on the base link (brace computed geometrically); the object's root pose is measured (pose_reached in :measure),
    ; not gated. Joint from the customs list (roles.target.joint / handle_key).

    (:objects
        hinged_jar.n.01_1 - hinged_jar.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (not (open hinged_jar.n.01_1))
        (ontop hinged_jar.n.01_1 breakfast_table.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (open ?hinged_jar.n.01_1)
            (layout_reached ?hinged_jar.n.01_1)
            (ontop ?hinged_jar.n.01_1 ?breakfast_table.n.01_1)
            (not (grasped ?agent.n.01_1 ?hinged_jar.n.01_1))
            (pose_settled ?hinged_jar.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?hinged_jar.n.01_1)
    )
)

(define (problem configuration_matching-84)
    (:domain ispatialgym)
    (:variant configuration_matching-articulation_close_large_scale-bottom_cabinet_push)

    ; ground_isg 2.0.0: configuration_matching-articulation_close_large_scale-bottom_cabinet (configuration_matching/articulation_close_large_scale.iddl; configuration_matching-articulation_close_large_scale#03/representative)
    ; owner 2026-10-12 ~08:50: close_large#03's c2 (push close, generation.close_by_push) - problem5 copied for configuration_matching-articulation_close_large_scale-bottom_cabinet_push
    ; Configuration matching - articulation (large-scale, close). Scene articulated object (roles/candidates.csv kind scene, bound per
    ; scene; joint from the customs list roles.target.joint / handle_key), one joint open at q_init in S (must satisfy Open)
    ; -> closed limit. Handle grasp in this direction too; base / trunk primary, arm secondary.

    (:objects
        cabinet.n.01_1 - cabinet.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (open cabinet.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (open ?cabinet.n.01_1))
            (not (grasped ?agent.n.01_1 ?cabinet.n.01_1))
            (pose_settled ?cabinet.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (layout_reached ?cabinet.n.01_1)
    )
)

(define (problem configuration_matching-26)
    (:domain ispatialgym)
    (:alias configuration_matching-attachment-dip_candle-candle_holder-breakfast_table)

    ; ground_isg 2.0.0 2026-09-16: configuration_matching-attachment-dip_candle-candle_holder-breakfast_table (configuration_matching/attachment.iddl; configuration_matching-attachment#01~T1/representative)
    ; Configuration matching - attachment. Target = male part (grasped), partner = female part (stands on the support, braced
    ; by the other gripper while attaching). The assembly group carries the fixed member-to-slot layout target; the
    ; partner's pose stays as at init. Male / female pairs with matching BEHAVIOR attachment meta-links come from
    ; roles/constraints_compatible.csv (partner_of, attach_type); the partner brace is computed geometrically (no artefact).

    (:objects
        dip.n.07_1 - dip.n.07
        candlestick.n.01_1 - candlestick.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:groups
        dip.n.07_1 candlestick.n.01_1 - assembly_group.n.01_1
    )

    (:init
        (ontop assembly_group.n.01_1 breakfast_table.n.01_1)
        (not (attached dip.n.07_1 candlestick.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (attached ?dip.n.07_1 ?candlestick.n.01_1)
            (ontop ?candlestick.n.01_1 ?breakfast_table.n.01_1)
            (layout_reached ?assembly_group.n.01_1)
            (not (grasped ?agent.n.01_1 ?assembly_group.n.01_1))
            (pose_settled ?assembly_group.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?assembly_group.n.01_1)
    )
)

(define (problem configuration_matching-58)
    (:domain ispatialgym)
    (:variant configuration_matching-articulation_open_small_scale-laptop-countertop)

    ; ground_isg 2.0.0: configuration_matching-articulation_open_small_scale-laptop-countertop (configuration_matching/articulation_open_small_scale.iddl; configuration_matching-articulation_open_small_scale#03~T2/representative)
    ; Configuration matching - articulation (small-scale, open). Spawned articulated object (toolbox, carton, hinged jar) on
    ; the support (floor for objects taller than 0.6 m), facing the robot; closed -> open to q_goal in S. Handle arm + brace
    ; arm on the base link (brace computed geometrically); the object's root pose is measured (pose_reached in :measure),
    ; not gated. Joint from the customs list (roles.target.joint / handle_key).

    (:objects
        laptop.n.01_1 - laptop.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (not (open laptop.n.01_1))
        (ontop laptop.n.01_1 countertop.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (open ?laptop.n.01_1)
            (layout_reached ?laptop.n.01_1)
            (ontop ?laptop.n.01_1 ?countertop.n.01_1)
            (not (grasped ?agent.n.01_1 ?laptop.n.01_1))
            (pose_settled ?laptop.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?laptop.n.01_1)
    )
)

(define (problem configuration_matching-42)
    (:domain ispatialgym)
    (:alias configuration_matching-articulation_close_small_scale-hinged_jar_vzwhbg-breakfast_table)

    ; ground_isg 2.0.0 2026-09-16: configuration_matching-articulation_close_small_scale-hinged_jar_vzwhbg-breakfast_table (configuration_matching/articulation_close_small_scale.iddl; configuration_matching-articulation_close_small_scale#02~T1/representative/fallback1:next_model)
    ; fallback 1 (next_model) of configuration_matching-articulation_close_small_scale-hinged_jar-breakfast_table: model = vzwhbg, slot = variation_geometry, primary_model = gqtsam
    ; Configuration matching - articulation (small-scale, close). Spawned articulated object on the support, one joint open
    ; at q_init in S -> closed limit. Handle arm + brace arm (brace computed geometrically); root pose measured. Joint from
    ; the customs list (roles.target.joint / handle_key).

    (:objects
        hinged_jar.n.01_1 - hinged_jar.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (open hinged_jar.n.01_1)
        (ontop hinged_jar.n.01_1 breakfast_table.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (open ?hinged_jar.n.01_1))
            (layout_reached ?hinged_jar.n.01_1)
            (ontop ?hinged_jar.n.01_1 ?breakfast_table.n.01_1)
            (not (grasped ?agent.n.01_1 ?hinged_jar.n.01_1))
            (pose_settled ?hinged_jar.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?hinged_jar.n.01_1)
    )
)

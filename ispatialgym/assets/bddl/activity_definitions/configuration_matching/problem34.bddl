(define (problem configuration_matching-34)
    (:domain ispatialgym)
    (:variant configuration_matching-articulation_close_small_scale-blender_eyedvd-countertop)

    ; ground_isg 2.0.0: configuration_matching-articulation_close_small_scale-blender_eyedvd-countertop (configuration_matching/articulation_close_small_scale.iddl; configuration_matching-articulation_close_small_scale#01~T3/representative/fallback1:next_model)
    ; fallback 1 (next_model) of configuration_matching-articulation_close_small_scale-blender-countertop: model = eyedvd, slot = variation_geometry, primary_model = cwkvib
    ; Configuration matching - articulation (small-scale, close). Spawned articulated object on the support, one joint open
    ; at q_init in S -> closed limit. Handle arm + brace arm (brace computed geometrically); root pose measured. Joint from
    ; the customs list (roles.target.joint / handle_key).

    (:objects
        blender.n.01_1 - blender.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (open blender.n.01_1)
        (ontop blender.n.01_1 countertop.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (open ?blender.n.01_1))
            (ontop ?blender.n.01_1 ?countertop.n.01_1)
            (not (grasped ?agent.n.01_1 ?blender.n.01_1))
            (pose_settled ?blender.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?blender.n.01_1)
        (layout_reached ?blender.n.01_1)
    )
)

(define (problem alignment-31)
    (:domain ispatialgym)
    (:variant alignment-world_vertical-paper_towel_dispenser_s080-walls)

    ; ground_isg 2.0.0: alignment-world_vertical-paper_towel_dispenser_s080-walls (alignment/world_vertical.iddl; alignment-world_vertical#03~T5/representative/fallback1:scale)
    ; fallback 1 (scale) of alignment-world_vertical-paper_towel_dispenser-walls: scale = 0.8, scale_source = override
    ; Alignment - world vertical. The target hangs on the support (a wall region, roles/candidates.csv kind scene) through a revolute
    ; hinge at its centre of mass (axis = wall normal, TRO constraint installed by the sampler, spec 5.5), starts tilted
    ; 15-45 deg in the wall plane and must be pushed upright (tangential push at the low end + brace at the high end).
    ; Orientation-only target; the position is fixed by the hinge. Push / brace contacts from
    ; contacts/<category>__<model>.json; spawn scale from the customs list (roles.target.scale).

    (:objects
        paper_towel_dispenser.n.01_1 - paper_towel_dispenser.n.01
        wall.n.01_1 - wall.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (pose_reached ?paper_towel_dispenser.n.01_1)
            (not (grasped ?agent.n.01_1 ?paper_towel_dispenser.n.01_1))
            (pose_settled ?paper_towel_dispenser.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )
)

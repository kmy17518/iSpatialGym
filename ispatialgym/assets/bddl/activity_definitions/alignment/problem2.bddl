(define (problem alignment-2)
    (:domain ispatialgym)

    (:alias world_horizontal)

    (:objects
        towel_rack.n.01_1 - towel_rack.n.01
        wall.n.01_1 - wall.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop agent.n.01_1 floor.n.01_1)
    )

    ; The towel rack hangs flat on the wall through a TRO revolute constraint at its centre of mass (not a BDDL
    ; literal) and starts tilted in the wall plane. Binary success: the rack is released and its orientation is within
    ; tolerance of the level (world horizontal) goal (TRO pose_targets["towel_rack.n.01_1"]: orientation_metric =
    ; "full", position_metric = null; models that look the same upside down list the 180-degree flip about the wall
    ; normal in orientation_equivalences).
    (:goal
        (and
            (pose_reached ?towel_rack.n.01_1)
            (not (grasped ?agent.n.01_1 ?towel_rack.n.01_1))
            (pose_settled ?towel_rack.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )
)

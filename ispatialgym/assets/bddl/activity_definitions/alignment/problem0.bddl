(define (problem alignment-0)
    (:domain ispatialgym)

    (:alias table_surface)

    (:objects
        fishing_rod.n.01_1 - fishing_rod.n.01
        table.n.02_1 - table.n.02
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop fishing_rod.n.01_1 table.n.02_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    ; Binary success: the rod is on the table, released, and its orientation is within tolerance of the goal
    ; (TRO pose_targets["fishing_rod.n.01_1"]: orientation_metric = "full", position_metric = null).
    (:goal
        (and
            (ontop ?fishing_rod.n.01_1 ?table.n.02_1)
            (pose_reached ?fishing_rod.n.01_1)
            (not (grasped ?agent.n.01_1 ?fishing_rod.n.01_1))
            (pose_settled ?fishing_rod.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )
)

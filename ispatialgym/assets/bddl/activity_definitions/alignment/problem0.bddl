(define (problem alignment-0)
    (:domain ispatialgym)
    (:variant alignment-axial-board_game-breakfast_table)

    ; Alignment (axial): the target rests on the support, free to turn about a vertical hinge through its centre of
    ; mass. Turn it until its long axis is parallel to the support's edges and its front faces the robot.

    (:objects
        board_game.n.01_1 - board_game.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop board_game.n.01_1 breakfast_table.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?board_game.n.01_1 ?breakfast_table.n.01_1)
            (pose_reached ?board_game.n.01_1)
            (not (grasped ?agent.n.01_1 ?board_game.n.01_1))
            (pose_settled ?board_game.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?board_game.n.01_1)
    )
)

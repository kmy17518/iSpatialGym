(define (problem object_scaling-15)
    (:domain ispatialgym)
    (:alias object_scaling-marker)

    ; ground_isg 2.0.0 2026-09-16: object_scaling-marker (object_scaling/object_scaling.iddl; object_scaling#15/representative)
    ; Object scaling. The target is held (right arm, fixed hold pose) at init and at the goal; the goal is a depth change of
    ; the target along the head-camera optical axis (TRO pose target: frame = head camera, position_metric = depth).

    (:objects
        marker.n.03_1 - marker.n.03
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop agent.n.01_1 floor.n.01_1)
        (grasped agent.n.01_1 marker.n.03_1)
    )

    (:goal
        (and
            (grasped ?agent.n.01_1 ?marker.n.03_1)
            (pose_reached ?marker.n.03_1)
            (pose_settled ?marker.n.03_1)
            (pose_settled ?agent.n.01_1)
        )
    )
)

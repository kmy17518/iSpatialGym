(define (problem object_scaling-1)
    (:domain ispatialgym)
    (:variant object_scaling-apple)

    ; Object scaling: the target starts in the right hand; move it along the head camera's optical axis until it
    ; appears at the goal size.

    (:objects
        apple.n.01_1 - apple.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop agent.n.01_1 floor.n.01_1)
        (grasped agent.n.01_1 apple.n.01_1)
    )

    (:goal
        (and
            (grasped ?agent.n.01_1 ?apple.n.01_1)
            (pose_reached ?apple.n.01_1)
            (pose_settled ?apple.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?apple.n.01_1)
    )
)

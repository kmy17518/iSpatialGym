(define (problem object_scaling-30)
    (:domain ispatialgym)
    (:alias object_scaling-cherry_tomato)

    ; ground_isg 2.0.0 2026-09-16: object_scaling-cherry_tomato (object_scaling/object_scaling.iddl; object_scaling#30/representative)
    ; Object scaling. The target is held (right arm, fixed hold pose) at init and at the goal; the goal is a depth change of
    ; the target along the head-camera optical axis (TRO pose target: frame = head camera, position_metric = depth).

    (:objects
        cherry_tomato.n.02_1 - cherry_tomato.n.02
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop agent.n.01_1 floor.n.01_1)
        (grasped agent.n.01_1 cherry_tomato.n.02_1)
    )

    (:goal
        (and
            (grasped ?agent.n.01_1 ?cherry_tomato.n.02_1)
            (pose_reached ?cherry_tomato.n.02_1)
            (pose_settled ?cherry_tomato.n.02_1)
            (pose_settled ?agent.n.01_1)
        )
    )
)

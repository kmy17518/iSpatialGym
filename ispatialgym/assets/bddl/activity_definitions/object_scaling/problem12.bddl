(define (problem object_scaling-12)
    (:domain ispatialgym)
    (:alias object_scaling-can_of_soda)

    ; ground_isg 2.0.0: object_scaling-can_of_soda (object_scaling/object_scaling.iddl; object_scaling#12/representative)
    ; Object scaling. The target is held (right arm, fixed hold pose) at init and at the goal; the goal is a depth change of
    ; the target along the head-camera optical axis (TRO pose target: frame = head camera, position_metric = depth).

    (:objects
        can__of__soda.n.01_1 - can__of__soda.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop agent.n.01_1 floor.n.01_1)
        (grasped agent.n.01_1 can__of__soda.n.01_1)
    )

    (:goal
        (and
            (grasped ?agent.n.01_1 ?can__of__soda.n.01_1)
            (pose_reached ?can__of__soda.n.01_1)
            (pose_settled ?can__of__soda.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )
)

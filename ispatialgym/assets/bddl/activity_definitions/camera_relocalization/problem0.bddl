(define (problem camera_relocalization-0)
    (:domain ispatialgym)

    (:objects
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop agent.n.01_1 floor.n.01_1)
    )

    ; Binary success: the head-camera sensor pose (TRO pose_targets["agent.n.01_1"], link = sensor key) is
    ; within both the position and the orientation tolerance of the goal camera pose.
    (:goal
        (and
            (pose_reached ?agent.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )
)

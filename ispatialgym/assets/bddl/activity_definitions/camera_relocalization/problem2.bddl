(define (problem camera_relocalization-2)
    (:domain ispatialgym)
    (:variant camera_relocalization-obstructed-hamper_1)

    ; Camera relocalization (obstructed): move the base and torso until the head camera reproduces the goal view; an
    ; obstacle stands on the shortest path.

    (:objects
        hamper.n.02_1 - hamper.n.02
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:groups
        hamper.n.02_1 - obstacles_group.n.01_1
    )

    (:init
        (ontop obstacles_group.n.01_1 floor.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (pose_reached ?agent.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?agent.n.01_1)
    )
)

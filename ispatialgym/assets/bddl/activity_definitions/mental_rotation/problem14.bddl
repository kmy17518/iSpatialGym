(define (problem mental_rotation-14)
    (:domain ispatialgym)
    (:alias mental_rotation-garlic_clove)

    ; ground_isg 2.0.0 2026-09-15: mental_rotation-garlic_clove (mental_rotation/mental_rotation.iddl; mental_rotation#14/representative)
    ; Mental rotation. The target is held (right arm, fixed hold pose) at init and at the goal; the goal is a world-frame
    ; orientation of the target, its position unchanged (TRO pose target: orientation_metric = full, equivalences per model).

    (:objects
        clove.n.03_1 - clove.n.03
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop agent.n.01_1 floor.n.01_1)
        (grasped agent.n.01_1 clove.n.03_1)
    )

    (:goal
        (and
            (grasped ?agent.n.01_1 ?clove.n.03_1)
            (pose_reached ?clove.n.03_1)
            (pose_settled ?clove.n.03_1)
            (pose_settled ?agent.n.01_1)
        )
    )
)

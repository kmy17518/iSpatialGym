(define (problem disembedding-48)
    (:domain ispatialgym)
    (:alias disembedding-soap_dispenser-soap_dispenser_2_bleaching_agent_atomizer_1-conference_table)

    ; ground_isg 2.0.0: disembedding-soap_dispenser-soap_dispenser_2_bleaching_agent_atomizer_1-conference_table (disembedding/disembedding.iddl; disembedding#09~T3/representative)
    ; Disembedding. Target and distractors on the source tray, destination tray beside it on the support; the target ends on
    ; the destination tray (centre, init orientation), no distractor does. Distractor categories come from the icl pools
    ; (roles/constraints_compatible.csv same-category / other-category), the member count (1-3) from the customs list
    ; (generation.groups.distractors); both are part of the alias (e.g. bottle_of_beer_3_bottle_of_sake_1). Trays are
    ; fixed models for now (tray gsxbym source, tray hvlfig destination; roles/candidates.csv).

    (:objects
        soap_dispenser.n.01_1 soap_dispenser.n.01_2 soap_dispenser.n.01_3 - soap_dispenser.n.01
        bleaching_agent__atomizer.n.01_1 - bleaching_agent__atomizer.n.01
        conference_table.n.01_1 - conference_table.n.01
        tray.n.01_1 tray.n.01_2 - tray.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:groups
        soap_dispenser.n.01_2 soap_dispenser.n.01_3 bleaching_agent__atomizer.n.01_1 - distractors_group.n.01_1
    )

    (:init
        (ontop tray.n.01_1 conference_table.n.01_1)
        (ontop tray.n.01_2 conference_table.n.01_1)
        (ontop soap_dispenser.n.01_1 tray.n.01_1)
        (ontop distractors_group.n.01_1 tray.n.01_1)
        (not (ontop soap_dispenser.n.01_1 tray.n.01_2))
        (not (ontop distractors_group.n.01_1 tray.n.01_2))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?soap_dispenser.n.01_1 ?tray.n.01_2)
            (not (ontop ?distractors_group.n.01_1 ?tray.n.01_2))
            (not (grasped ?agent.n.01_1 ?soap_dispenser.n.01_1))
            (pose_settled ?soap_dispenser.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?soap_dispenser.n.01_1)
    )
)

(define (problem disembedding-59)
    (:domain ispatialgym)
    (:alias disembedding-pack_of_cigarettes-pack_of_cigarettes_2_bandage_1-countertop)

    ; ground_isg 2.0.0 2026-09-16: disembedding-pack_of_cigarettes-pack_of_cigarettes_2_bandage_1-countertop (disembedding/disembedding.iddl; disembedding#15~T2/representative)
    ; Disembedding. Target and distractors on the source tray, destination tray beside it on the support; the target ends on
    ; the destination tray (centre, init orientation), no distractor does. Distractor categories come from the icl pools
    ; (roles/constraints_compatible.csv same-category / other-category), the member count (1-3) from the customs list
    ; (generation.groups.distractors); both are part of the alias (e.g. bottle_of_beer_3_bottle_of_sake_1). Trays are
    ; fixed models for now (tray gsxbym source, tray hvlfig destination; roles/candidates.csv).

    (:objects
        pack__of__cigarettes.n.01_1 pack__of__cigarettes.n.01_2 pack__of__cigarettes.n.01_3 - pack__of__cigarettes.n.01
        bandage.n.01_1 - bandage.n.01
        countertop.n.01_1 - countertop.n.01
        tray.n.01_1 tray.n.01_2 - tray.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:groups
        pack__of__cigarettes.n.01_2 pack__of__cigarettes.n.01_3 bandage.n.01_1 - distractors_group.n.01_1
    )

    (:init
        (ontop tray.n.01_1 countertop.n.01_1)
        (ontop tray.n.01_2 countertop.n.01_1)
        (ontop pack__of__cigarettes.n.01_1 tray.n.01_1)
        (ontop distractors_group.n.01_1 tray.n.01_1)
        (not (ontop pack__of__cigarettes.n.01_1 tray.n.01_2))
        (not (ontop distractors_group.n.01_1 tray.n.01_2))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?pack__of__cigarettes.n.01_1 ?tray.n.01_2)
            (not (ontop ?distractors_group.n.01_1 ?tray.n.01_2))
            (not (grasped ?agent.n.01_1 ?pack__of__cigarettes.n.01_1))
            (pose_settled ?pack__of__cigarettes.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?pack__of__cigarettes.n.01_1)
    )
)

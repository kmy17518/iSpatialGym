(define (problem disembedding-20)
    (:domain ispatialgym)
    (:alias disembedding-pencil_case-chocolate_bar_1_flashlight_1_granola_bar_1-breakfast_table)

    ; ground_isg 2.0.0 2026-09-16: disembedding-pencil_case-chocolate_bar_1_flashlight_1_granola_bar_1-breakfast_table (disembedding/disembedding.iddl; disembedding#20~T1/representative)
    ; Disembedding. Target and distractors on the source tray, destination tray beside it on the support; the target ends on
    ; the destination tray (centre, init orientation), no distractor does. Distractor categories come from the icl pools
    ; (roles/constraints_compatible.csv same-category / other-category), the member count (1-3) from the customs list
    ; (generation.groups.distractors); both are part of the alias (e.g. bottle_of_beer_3_bottle_of_sake_1). Trays are
    ; fixed models for now (tray gsxbym source, tray hvlfig destination; roles/candidates.csv).

    (:objects
        pencil_box.n.01_1 - pencil_box.n.01
        chocolate_bar.n.01_1 - chocolate_bar.n.01
        flashlight.n.01_1 - flashlight.n.01
        granola_bar.n.01_1 - granola_bar.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        tray.n.01_1 tray.n.01_2 - tray.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:groups
        chocolate_bar.n.01_1 flashlight.n.01_1 granola_bar.n.01_1 - distractors_group.n.01_1
    )

    (:init
        (ontop tray.n.01_1 breakfast_table.n.01_1)
        (ontop tray.n.01_2 breakfast_table.n.01_1)
        (ontop pencil_box.n.01_1 tray.n.01_1)
        (ontop distractors_group.n.01_1 tray.n.01_1)
        (not (ontop pencil_box.n.01_1 tray.n.01_2))
        (not (ontop distractors_group.n.01_1 tray.n.01_2))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?pencil_box.n.01_1 ?tray.n.01_2)
            (not (ontop ?distractors_group.n.01_1 ?tray.n.01_2))
            (not (grasped ?agent.n.01_1 ?pencil_box.n.01_1))
            (pose_settled ?pencil_box.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?pencil_box.n.01_1)
    )
)

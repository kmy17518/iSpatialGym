(define (problem inter_object_relation_satisfaction-42)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-inside-ice_cube-beer_glass-conference_table)

    ; ground_isg 2.0.0 2026-09-16: inter_object_relation_satisfaction-inside-ice_cube-beer_glass-conference_table (inter_object_relation_satisfaction/inside.iddl; inter_object_relation_satisfaction-inside#04~T3/representative)
    ; IORS - inside. Target lowered into the partner (fillable container) on the support; the target's goal orientation is
    ; whatever settles (TRO orientation_metric null), which also admits flowers stood in vases. Both poses measured. The
    ; insert grasp pipeline (pads on the upper part of the object so the lower body can enter the container; flowers held
    ; by the upper stem) is required.

    (:objects
        ice_cube.n.01_1 - ice_cube.n.01
        beer_glass.n.01_1 - beer_glass.n.01
        conference_table.n.01_1 - conference_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop ice_cube.n.01_1 conference_table.n.01_1)
        (ontop beer_glass.n.01_1 conference_table.n.01_1)
        (not (inside ice_cube.n.01_1 beer_glass.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (inside ?ice_cube.n.01_1 ?beer_glass.n.01_1)
            (not (grasped ?agent.n.01_1 ?ice_cube.n.01_1))
            (not (grasped ?agent.n.01_1 ?beer_glass.n.01_1))
            (pose_settled ?ice_cube.n.01_1)
            (pose_settled ?beer_glass.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?ice_cube.n.01_1)
        (pose_reached ?beer_glass.n.01_1)
    )
)

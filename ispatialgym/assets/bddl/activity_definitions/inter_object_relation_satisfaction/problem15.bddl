(define (problem inter_object_relation_satisfaction-15)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-ontop_large_scale-shampoo_dispenser-countertop-countertop)

    ; ground_isg 2.0.0 2026-09-15: inter_object_relation_satisfaction-ontop_large_scale-shampoo_dispenser-countertop-countertop (inter_object_relation_satisfaction/ontop_large_scale.iddl; inter_object_relation_satisfaction-ontop_large_scale#02/representative)
    ; IORS - ontop (large-scale). The target starts on a support (a table within 3 m of the partner, or the floor beside it -
    ; an explicit support choice made by ground_isg, never a runtime fallback) and ends on top of a large scene partner
    ; (bed, sofa, desk, breakfast table, countertop; roles/candidates.csv kind scene). Three recorded stances: init A, manipulation B,
    ; placement C.

    (:objects
        shampoo__dispenser.n.01_1 - shampoo__dispenser.n.01
        countertop.n.01_1 countertop.n.01_2 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop shampoo__dispenser.n.01_1 countertop.n.01_2)
        (not (ontop shampoo__dispenser.n.01_1 countertop.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?shampoo__dispenser.n.01_1 ?countertop.n.01_1)
            (not (grasped ?agent.n.01_1 ?shampoo__dispenser.n.01_1))
            (pose_settled ?shampoo__dispenser.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?shampoo__dispenser.n.01_1)
    )
)

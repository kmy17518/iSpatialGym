(define (problem inter_object_relation_satisfaction-39)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-inside-quartz-saucepot-countertop)

    ; ground_isg 2.0.0 2026-09-16: inter_object_relation_satisfaction-inside-quartz-saucepot-countertop (inter_object_relation_satisfaction/inside.iddl; inter_object_relation_satisfaction-inside#03~T2/representative)
    ; IORS - inside. Target lowered into the partner (fillable container) on the support; the target's goal orientation is
    ; whatever settles (TRO orientation_metric null), which also admits flowers stood in vases. Both poses measured. The
    ; insert grasp pipeline (pads on the upper part of the object so the lower body can enter the container; flowers held
    ; by the upper stem) is required.

    (:objects
        quartz.n.02_1 - quartz.n.02
        saucepot.n.01_1 - saucepot.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop quartz.n.02_1 countertop.n.01_1)
        (ontop saucepot.n.01_1 countertop.n.01_1)
        (not (inside quartz.n.02_1 saucepot.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (inside ?quartz.n.02_1 ?saucepot.n.01_1)
            (not (grasped ?agent.n.01_1 ?quartz.n.02_1))
            (not (grasped ?agent.n.01_1 ?saucepot.n.01_1))
            (pose_settled ?quartz.n.02_1)
            (pose_settled ?saucepot.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?quartz.n.02_1)
        (pose_reached ?saucepot.n.01_1)
    )
)

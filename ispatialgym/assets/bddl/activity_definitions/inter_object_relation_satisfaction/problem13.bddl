(define (problem inter_object_relation_satisfaction-13)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-nextto-cinnamon_stick-star_anise-breakfast_table)

    ; ground_isg 2.0.0 2026-09-15: inter_object_relation_satisfaction-nextto-cinnamon_stick-star_anise-breakfast_table (inter_object_relation_satisfaction/nextto.iddl; inter_object_relation_satisfaction-nextto#04/representative)
    ; IORS - nextto. Target and partner on the support with an init gap above the NextTo bound; the target is moved to the
    ; nearest position that satisfies NextTo (gap below mean(dims_a + dims_b)/6, adjacency rays), same orientation.

    (:objects
        cinnamon_bark.n.01_1 - cinnamon_bark.n.01
        chinese_anise.n.02_1 - chinese_anise.n.02
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop cinnamon_bark.n.01_1 breakfast_table.n.01_1)
        (ontop chinese_anise.n.02_1 breakfast_table.n.01_1)
        (not (nextto cinnamon_bark.n.01_1 chinese_anise.n.02_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (nextto ?cinnamon_bark.n.01_1 ?chinese_anise.n.02_1)
            (not (grasped ?agent.n.01_1 ?cinnamon_bark.n.01_1))
            (not (grasped ?agent.n.01_1 ?chinese_anise.n.02_1))
            (pose_settled ?cinnamon_bark.n.01_1)
            (pose_settled ?chinese_anise.n.02_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?cinnamon_bark.n.01_1)
        (pose_reached ?chinese_anise.n.02_1)
    )
)

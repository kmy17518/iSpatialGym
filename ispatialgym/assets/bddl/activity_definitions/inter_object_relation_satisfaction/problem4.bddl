(define (problem inter_object_relation_satisfaction-4)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-under_small_scale-teacup-saucer-breakfast_table)

    ; Inter-object relation (under, small scale): set the target down on the partner so that the partner is under it,
    ; hence the argument order (under partner target). Both poses are measured.

    (:objects
        teacup.n.02_1 - teacup.n.02
        saucer.n.02_1 - saucer.n.02
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop teacup.n.02_1 breakfast_table.n.01_1)
        (ontop saucer.n.02_1 breakfast_table.n.01_1)
        (not (under saucer.n.02_1 teacup.n.02_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (under ?saucer.n.02_1 ?teacup.n.02_1)
            (not (grasped ?agent.n.01_1 ?teacup.n.02_1))
            (not (grasped ?agent.n.01_1 ?saucer.n.02_1))
            (pose_settled ?teacup.n.02_1)
            (pose_settled ?saucer.n.02_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?teacup.n.02_1)
        (pose_reached ?saucer.n.02_1)
    )
)

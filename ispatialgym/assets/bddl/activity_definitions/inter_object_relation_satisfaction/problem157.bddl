(define (problem inter_object_relation_satisfaction-157)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-touching_large_scale-ottoman-sofa-floor)

    ; oracle-fix 2026-11-03: touching_large#01 hand-made (problem120 with footstool / sofa): ottoman/miftfy spawned on the floor of house_single_floor
    ; living_room_0 and pushed by the base (two closed hands, no grasp) until it touches sofa_lugrhk_0 (generation.touching_push base; registry mode test).
    ; (the storage box's drop + arm push does not apply: the ottoman has no grasp)
    ; IORS - touching (large-scale). The target starts on a support (a table near the partner, or the floor beside it - an
    ; explicit support choice made by ground_isg, never a runtime fallback) and ends touching a large scene partner (a copy of
    ; ontop_large_scale with the goal predicate touching; registered 2026-10-12, the sampler mode comes next). Three recorded
    ; stances: init A, manipulation B, placement C.

    (:objects
        footstool.n.01_1 - footstool.n.01
        sofa.n.01_1 - sofa.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop footstool.n.01_1 floor.n.01_1)
        (not (touching footstool.n.01_1 sofa.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (touching ?footstool.n.01_1 ?sofa.n.01_1)
            (not (grasped ?agent.n.01_1 ?footstool.n.01_1))
            (pose_settled ?footstool.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?footstool.n.01_1)
    )
)

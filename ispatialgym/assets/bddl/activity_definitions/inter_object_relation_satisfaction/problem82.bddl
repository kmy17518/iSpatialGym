(define (problem inter_object_relation_satisfaction-82)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-nextto-tablespoon-chopstick-pedestal_table)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-nextto-tablespoon-chopstick-pedestal_table (inter_object_relation_satisfaction/nextto.iddl; inter_object_relation_satisfaction-nextto#03~T5/representative)
    ; IORS - nextto. Target and partner on the support with an init gap above the NextTo bound; the target is moved to the
    ; nearest position that satisfies NextTo (gap below mean(dims_a + dims_b)/6, adjacency rays), same orientation.

    (:objects
        tablespoon.n.02_1 - tablespoon.n.02
        chopstick.n.01_1 - chopstick.n.01
        pedestal_table.n.01_1 - pedestal_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop tablespoon.n.02_1 pedestal_table.n.01_1)
        (ontop chopstick.n.01_1 pedestal_table.n.01_1)
        (not (nextto tablespoon.n.02_1 chopstick.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (nextto ?tablespoon.n.02_1 ?chopstick.n.01_1)
            (not (grasped ?agent.n.01_1 ?tablespoon.n.02_1))
            (not (grasped ?agent.n.01_1 ?chopstick.n.01_1))
            (pose_settled ?tablespoon.n.02_1)
            (pose_settled ?chopstick.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?tablespoon.n.02_1)
        (pose_reached ?chopstick.n.01_1)
    )
)

(define (problem inter_object_relation_satisfaction-110)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-touching_small_scale-box_of_cereal_s080-box_of_cereal-desk)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-touching_small_scale-box_of_cereal-box_of_cereal-desk (inter_object_relation_satisfaction/touching_small_scale.iddl; inter_object_relation_satisfaction-touching#02~T6/representative)
    ; owner 2026-10-12 ~10:25 item 4 touching#02 variant C (inter_object_relation_satisfaction-touching#02~C3): hand-made from this grounding - target box_of_cereal/iucshm x0.8 (box_of_cereal__iucshm__s080), registry mode test
    ; IORS - touching (small-scale). Target grasped and set down next to the partner (partner on the robot's left), then pushed against it
    ; while the other gripper braces the partner's far side (push and brace computed geometrically, no artefact); the
    ; partner must not move (> 5 mm) at the goal.

    (:objects
        box__of__cereal.n.01_1 box__of__cereal.n.01_2 - box__of__cereal.n.01
        desk.n.01_1 - desk.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop box__of__cereal.n.01_1 desk.n.01_1)
        (ontop box__of__cereal.n.01_2 desk.n.01_1)
        (not (touching box__of__cereal.n.01_1 box__of__cereal.n.01_2))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (touching ?box__of__cereal.n.01_1 ?box__of__cereal.n.01_2)
            (not (grasped ?agent.n.01_1 ?box__of__cereal.n.01_1))
            (not (grasped ?agent.n.01_1 ?box__of__cereal.n.01_2))
            (pose_settled ?box__of__cereal.n.01_1)
            (pose_settled ?box__of__cereal.n.01_2)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?box__of__cereal.n.01_1)
        (pose_reached ?box__of__cereal.n.01_2)
    )
)

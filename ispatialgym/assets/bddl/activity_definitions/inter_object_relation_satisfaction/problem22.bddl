(define (problem inter_object_relation_satisfaction-22)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-ontop_small_scale-pickle-cutting_board-breakfast_table)

    ; ground_isg 2.0.0 2026-09-16: inter_object_relation_satisfaction-ontop_small_scale-pickle-cutting_board-breakfast_table (inter_object_relation_satisfaction/ontop_small_scale.iddl; inter_object_relation_satisfaction-ontop_small_scale#04~T1/representative)
    ; IORS - ontop (small-scale). Target and partner both on the support; the target ends centred on top of the partner with
    ; its init orientation; the partner stays where it was. Both poses measured.

    (:objects
        pickle.n.01_1 - pickle.n.01
        chopping_board.n.01_1 - chopping_board.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop pickle.n.01_1 breakfast_table.n.01_1)
        (ontop chopping_board.n.01_1 breakfast_table.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?pickle.n.01_1 ?chopping_board.n.01_1)
            (not (grasped ?agent.n.01_1 ?pickle.n.01_1))
            (not (grasped ?agent.n.01_1 ?chopping_board.n.01_1))
            (pose_settled ?pickle.n.01_1)
            (pose_settled ?chopping_board.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?pickle.n.01_1)
        (pose_reached ?chopping_board.n.01_1)
    )
)

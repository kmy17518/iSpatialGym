(define (problem inter_object_relation_satisfaction-22)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-nextto_large_scale-serving_cart-coffee_table-floor)

    ; owner 2026-10-13 ~20:34: problem123 copied for inter_object_relation_satisfaction-nextto_large_scale-serving_cart-coffee_table-floor - the partner coffee_table.n.01 (coffee_table_rlsebe_0, house_single_floor living_room_0)
    ; hand-grounded (owner 2026-10-12 ~16:05 items 3 / 4, nextto_large#02): problem89 (inter_object_relation_satisfaction-under_large_scale-sandal-breakfast_table-floor) copied with the target
    ; serving_cart.n.01 (serving_cart/heqtlk, spawned on the floor of house_single_floor/dining_room_0) and the relation nextto
    ; (inter_object_relation_satisfaction/nextto_large_scale.iddl). The cart starts on the floor away from breakfast_table_rhjoby_0 and ends next to it, pushed by the base (no grasp).

    (:objects
        serving_cart.n.01_1 - serving_cart.n.01
        coffee_table.n.01_1 - coffee_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop serving_cart.n.01_1 floor.n.01_1)
        (not (nextto serving_cart.n.01_1 coffee_table.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (nextto ?serving_cart.n.01_1 ?coffee_table.n.01_1)
            (not (grasped ?agent.n.01_1 ?serving_cart.n.01_1))
            (pose_settled ?serving_cart.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?serving_cart.n.01_1)
    )
)

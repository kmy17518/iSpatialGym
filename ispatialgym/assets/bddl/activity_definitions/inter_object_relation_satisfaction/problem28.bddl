(define (problem inter_object_relation_satisfaction-28)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-under_large_scale-marker-desk-floor)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-under_large_scale-marker-desk-floor (inter_object_relation_satisfaction/under_large_scale.iddl; inter_object_relation_satisfaction-under_large_scale#02/representative/fallback1:init_surface)
    ; fallback 1 (init_surface) of inter_object_relation_satisfaction-under_large_scale-marker-desk-desk: init_surface = floor
    ; IORS - under (large-scale). The target starts on a support (a table near the partner, the floor beside it, or the
    ; partner's own top) and ends on the floor under a large scene partner (bed, sofa, desk, breakfast table; roles/candidates.csv
    ; kind scene) at a goal cell where an upward ray hits the partner above target height + 3 cm. Argument order: the
    ; target is under the partner. When partner and support are the same scene object the BDDL declares it once.

    (:objects
        marker.n.03_1 - marker.n.03
        desk.n.01_1 - desk.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop marker.n.03_1 floor.n.01_1)
        (not (under marker.n.03_1 desk.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (under ?marker.n.03_1 ?desk.n.01_1)
            (not (grasped ?agent.n.01_1 ?marker.n.03_1))
            (pose_settled ?marker.n.03_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?marker.n.03_1)
    )
)

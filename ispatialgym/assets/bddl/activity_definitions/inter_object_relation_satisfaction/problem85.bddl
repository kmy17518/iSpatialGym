(define (problem inter_object_relation_satisfaction-85)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-under_small_scale-bottle_of_supplements-tray-conference_table)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-under_small_scale-bottle_of_supplements-tray-conference_table (inter_object_relation_satisfaction/under_small_scale.iddl; inter_object_relation_satisfaction-under_small_scale#03~T3/representative)
    ; IORS - under (small-scale). Both objects on the support; the manipulated target (glass, teacup, fries, bottle) is set
    ; down centred on the partner (coaster, saucer, platter, tray) so that the PARTNER ends under the target. Argument order
    ; is therefore (under partner target). Both poses measured.

    (:objects
        bottle__of__supplements.n.01_1 - bottle__of__supplements.n.01
        tray.n.01_1 - tray.n.01
        conference_table.n.01_1 - conference_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop bottle__of__supplements.n.01_1 conference_table.n.01_1)
        (ontop tray.n.01_1 conference_table.n.01_1)
        (not (under tray.n.01_1 bottle__of__supplements.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (under ?tray.n.01_1 ?bottle__of__supplements.n.01_1)
            (not (grasped ?agent.n.01_1 ?bottle__of__supplements.n.01_1))
            (not (grasped ?agent.n.01_1 ?tray.n.01_1))
            (pose_settled ?bottle__of__supplements.n.01_1)
            (pose_settled ?tray.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?bottle__of__supplements.n.01_1)
        (pose_reached ?tray.n.01_1)
    )
)

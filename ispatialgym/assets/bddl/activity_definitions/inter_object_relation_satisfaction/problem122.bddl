(define (problem inter_object_relation_satisfaction-122)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-inside_large_scale-plate-drop_in_sink-bar)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-inside_large_scale-plate-drop_in_sink-bar (inter_object_relation_satisfaction/inside_large_scale.iddl; inter_object_relation_satisfaction-inside_large_scale#03~T2/representative)
    ; owner 2026-10-12 ~16:05 iorsl3 inside inter_object_relation_satisfaction-inside_large_scale#03: hand-made (rendered from the iddl; the subtask has no candidates rows) - plate/luhkiz into drop_in_sink_awvzkn_0 from bar_udatjt_0 (1.3 m, the 1.05 m kitchen island, sheet ~T2); registry mode test
    ; IORS - inside (large-scale). The target starts on a support (a table near the partner, or the floor beside it - an
    ; explicit support choice made by ground_isg, never a runtime fallback) and ends inside a large scene partner (a copy of
    ; ontop_large_scale with the goal predicate inside; registered 2026-10-12, the sampler mode comes next). Three recorded
    ; stances: init A, manipulation B, placement C.

    (:objects
        plate.n.04_1 - plate.n.04
        sink.n.01_1 - sink.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop plate.n.04_1 countertop.n.01_1)
        (not (inside plate.n.04_1 sink.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (inside ?plate.n.04_1 ?sink.n.01_1)
            (not (grasped ?agent.n.01_1 ?plate.n.04_1))
            (pose_settled ?plate.n.04_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?plate.n.04_1)
    )
)

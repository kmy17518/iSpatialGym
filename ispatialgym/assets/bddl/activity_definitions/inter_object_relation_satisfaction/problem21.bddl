(define (problem inter_object_relation_satisfaction-21)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-ontop_small_scale-bar_soap_utgixp-soap_dish-countertop)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-ontop_small_scale-bar_soap_utgixp-soap_dish-countertop (inter_object_relation_satisfaction/ontop_small_scale.iddl; inter_object_relation_satisfaction-ontop_small_scale#03~T3/representative/fallback1:next_model)
    ; fallback 1 (next_model) of inter_object_relation_satisfaction-ontop_small_scale-bar_soap-soap_dish-countertop: model = utgixp, slot = variation_geometry, primary_model = ofargb
    ; IORS - ontop (small-scale). Target and partner both on the support; the target ends centred on top of the partner with
    ; its init orientation; the partner stays where it was. Both poses measured.

    (:objects
        bar_soap.n.01_1 - bar_soap.n.01
        soap_dish.n.01_1 - soap_dish.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop bar_soap.n.01_1 countertop.n.01_1)
        (ontop soap_dish.n.01_1 countertop.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?bar_soap.n.01_1 ?soap_dish.n.01_1)
            (not (grasped ?agent.n.01_1 ?bar_soap.n.01_1))
            (not (grasped ?agent.n.01_1 ?soap_dish.n.01_1))
            (pose_settled ?bar_soap.n.01_1)
            (pose_settled ?soap_dish.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?bar_soap.n.01_1)
        (pose_reached ?soap_dish.n.01_1)
    )
)

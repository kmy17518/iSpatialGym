(define (problem inter_object_relation_satisfaction-8)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-ontop_small_scale-steak-frying_pan-countertop)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-ontop_small_scale-steak-frying_pan-countertop (inter_object_relation_satisfaction/ontop_small_scale.iddl; inter_object_relation_satisfaction-ontop_small_scale#02~T1/representative)
    ; IORS - ontop (small-scale). Target and partner both on the support; the target ends centred on top of the partner with
    ; its init orientation; the partner stays where it was. Both poses measured.

    (:objects
        steak.n.01_1 - steak.n.01
        frying_pan.n.01_1 - frying_pan.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop steak.n.01_1 countertop.n.01_1)
        (ontop frying_pan.n.01_1 countertop.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?steak.n.01_1 ?frying_pan.n.01_1)
            (not (grasped ?agent.n.01_1 ?steak.n.01_1))
            (not (grasped ?agent.n.01_1 ?frying_pan.n.01_1))
            (pose_settled ?steak.n.01_1)
            (pose_settled ?frying_pan.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?steak.n.01_1)
        (pose_reached ?frying_pan.n.01_1)
    )
)

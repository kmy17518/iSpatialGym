(define (problem inter_object_relation_satisfaction-17)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-ontop_large_scale-box_of_shampoo-sofa-bar)

    ; ground_isg 2.0.0 2026-09-15: inter_object_relation_satisfaction-ontop_large_scale-box_of_shampoo-sofa-bar (inter_object_relation_satisfaction/ontop_large_scale.iddl; inter_object_relation_satisfaction-ontop_large_scale#04/representative)
    ; IORS - ontop (large-scale). The target starts on a support (a table within 3 m of the partner, or the floor beside it -
    ; an explicit support choice made by ground_isg, never a runtime fallback) and ends on top of a large scene partner
    ; (bed, sofa, desk, breakfast table, countertop; roles/candidates.csv kind scene). Three recorded stances: init A, manipulation B,
    ; placement C.

    (:objects
        box__of__shampoo.n.01_1 - box__of__shampoo.n.01
        sofa.n.01_1 - sofa.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop box__of__shampoo.n.01_1 countertop.n.01_1)
        (not (ontop box__of__shampoo.n.01_1 sofa.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?box__of__shampoo.n.01_1 ?sofa.n.01_1)
            (not (grasped ?agent.n.01_1 ?box__of__shampoo.n.01_1))
            (pose_settled ?box__of__shampoo.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?box__of__shampoo.n.01_1)
    )
)

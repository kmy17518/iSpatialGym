(define (problem inter_object_relation_satisfaction-92)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-touching-box_of_cereal-box_of_cereal-countertop)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-touching-box_of_cereal-box_of_cereal-countertop (inter_object_relation_satisfaction/touching.iddl; inter_object_relation_satisfaction-touching#02~T1/representative)
    ; IORS - touching. Target grasped and set down next to the partner (partner on the robot's left), then pushed against it
    ; while the other gripper braces the partner's far side (push and brace computed geometrically, no artefact); the
    ; partner must not move (> 5 mm) at the goal.

    (:objects
        box__of__cereal.n.01_1 box__of__cereal.n.01_2 - box__of__cereal.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop box__of__cereal.n.01_1 countertop.n.01_1)
        (ontop box__of__cereal.n.01_2 countertop.n.01_1)
        (not (touching box__of__cereal.n.01_1 box__of__cereal.n.01_2))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (touching ?box__of__cereal.n.01_1 ?box__of__cereal.n.01_2)
            (not (grasped ?agent.n.01_1 ?box__of__cereal.n.01_1))
            (not (grasped ?agent.n.01_1 ?box__of__cereal.n.01_2))
            (pose_settled ?box__of__cereal.n.01_1)
            (pose_settled ?box__of__cereal.n.01_2)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?box__of__cereal.n.01_1)
        (pose_reached ?box__of__cereal.n.01_2)
    )
)

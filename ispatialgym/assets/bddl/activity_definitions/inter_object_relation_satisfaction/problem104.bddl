(define (problem inter_object_relation_satisfaction-104)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-touching-spray_bottle-bottle_of_detergent-desk)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-touching-spray_bottle-bottle_of_detergent-desk (inter_object_relation_satisfaction/touching.iddl; inter_object_relation_satisfaction-touching#04~T5/representative)
    ; IORS - touching. Target grasped and set down next to the partner (partner on the robot's left), then pushed against it
    ; while the other gripper braces the partner's far side (push and brace computed geometrically, no artefact); the
    ; partner must not move (> 5 mm) at the goal.

    (:objects
        atomizer.n.01_1 - atomizer.n.01
        bottle__of__detergent.n.01_1 - bottle__of__detergent.n.01
        desk.n.01_1 - desk.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop atomizer.n.01_1 desk.n.01_1)
        (ontop bottle__of__detergent.n.01_1 desk.n.01_1)
        (not (touching atomizer.n.01_1 bottle__of__detergent.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (touching ?atomizer.n.01_1 ?bottle__of__detergent.n.01_1)
            (not (grasped ?agent.n.01_1 ?atomizer.n.01_1))
            (not (grasped ?agent.n.01_1 ?bottle__of__detergent.n.01_1))
            (pose_settled ?atomizer.n.01_1)
            (pose_settled ?bottle__of__detergent.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?atomizer.n.01_1)
        (pose_reached ?bottle__of__detergent.n.01_1)
    )
)

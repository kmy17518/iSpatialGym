(define (problem inter_object_relation_satisfaction-71)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-touching-teacup-teapot-conference_table)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-touching-teacup-teapot-conference_table (inter_object_relation_satisfaction/touching.iddl; inter_object_relation_satisfaction-touching#02~T3/representative)
    ; IORS - touching. Target grasped and set down next to the partner (partner on the robot's left), then pushed against it
    ; while the other gripper braces the partner's far side (push and brace computed geometrically, no artefact); the
    ; partner must not move (> 5 mm) at the goal.

    (:objects
        teacup.n.02_1 - teacup.n.02
        teapot.n.01_1 - teapot.n.01
        conference_table.n.01_1 - conference_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop teacup.n.02_1 conference_table.n.01_1)
        (ontop teapot.n.01_1 conference_table.n.01_1)
        (not (touching teacup.n.02_1 teapot.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (touching ?teacup.n.02_1 ?teapot.n.01_1)
            (not (grasped ?agent.n.01_1 ?teacup.n.02_1))
            (not (grasped ?agent.n.01_1 ?teapot.n.01_1))
            (pose_settled ?teacup.n.02_1)
            (pose_settled ?teapot.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?teacup.n.02_1)
        (pose_reached ?teapot.n.01_1)
    )
)

(define (problem inter_object_relation_satisfaction-72)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-touching-carton_of_milk-box_of_cookies-countertop)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-touching-carton_of_milk-box_of_cookies-countertop (inter_object_relation_satisfaction/touching.iddl; inter_object_relation_satisfaction-touching#03~T2/representative)
    ; IORS - touching. Target grasped and set down next to the partner (partner on the robot's left), then pushed against it
    ; while the other gripper braces the partner's far side (push and brace computed geometrically, no artefact); the
    ; partner must not move (> 5 mm) at the goal.

    (:objects
        carton__of__milk.n.01_1 - carton__of__milk.n.01
        box__of__cookies.n.01_1 - box__of__cookies.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop carton__of__milk.n.01_1 countertop.n.01_1)
        (ontop box__of__cookies.n.01_1 countertop.n.01_1)
        (not (touching carton__of__milk.n.01_1 box__of__cookies.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (touching ?carton__of__milk.n.01_1 ?box__of__cookies.n.01_1)
            (not (grasped ?agent.n.01_1 ?carton__of__milk.n.01_1))
            (not (grasped ?agent.n.01_1 ?box__of__cookies.n.01_1))
            (pose_settled ?carton__of__milk.n.01_1)
            (pose_settled ?box__of__cookies.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?carton__of__milk.n.01_1)
        (pose_reached ?box__of__cookies.n.01_1)
    )
)

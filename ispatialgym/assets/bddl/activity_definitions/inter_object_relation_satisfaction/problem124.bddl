(define (problem inter_object_relation_satisfaction-124)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-touching_small_scale-spray_bottle_wegawe-bottle_of_detergent-countertop)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-touching_small_scale-spray_bottle-bottle_of_detergent-countertop (inter_object_relation_satisfaction/touching_small_scale.iddl; inter_object_relation_satisfaction-touching#04~T2/representative)
    ; owner 2026-10-12 ~16:05 touching#04 with spray_bottle/wegawe (~W1, ~W2): hand-made from this grounding - target spray_bottle/wegawe (spray_bottle__wegawe__t), registry mode test
    ; IORS - touching (small-scale). Target grasped and set down next to the partner (partner on the robot's left), then pushed against it
    ; while the other gripper braces the partner's far side (push and brace computed geometrically, no artefact); the
    ; partner must not move (> 5 mm) at the goal.

    (:objects
        atomizer.n.01_1 - atomizer.n.01
        bottle__of__detergent.n.01_1 - bottle__of__detergent.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop atomizer.n.01_1 countertop.n.01_1)
        (ontop bottle__of__detergent.n.01_1 countertop.n.01_1)
        (not (touching atomizer.n.01_1 bottle__of__detergent.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (touching ?atomizer.n.01_1 ?bottle__of__detergent.n.01_1)
            (not (grasped ?agent.n.01_1 ?atomizer.n.01_1))
            (not (grasped ?agent.n.01_1 ?bottle__of__detergent.n.01_1))
            (pose_settled ?atomizer.n.01_1)
            (pose_settled ?bottle__of__detergent.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?atomizer.n.01_1)
        (pose_reached ?bottle__of__detergent.n.01_1)
    )
)

(define (problem inter_object_relation_satisfaction-158)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-ontop_large_scale-pillow-bed-bed)

    ; oracle-fix 2026-11-03: ontop_large#03 hand-made (rendered as problem18 from ontop_large_scale.iddl; the subtask has no candidates rows) -
    ; pillow/mltefs onto bed_kddswt_0 from the other bed bed_kddswt_1 (hotel_suite_large bedroom_0); grasp pillow__mltefs__lp; registry mode test
    ; IORS - ontop (large-scale). The target starts on a support (a table within 3 m of the partner, or the floor beside it -
    ; an explicit support choice made by ground_isg, never a runtime fallback) and ends on top of a large scene partner
    ; (bed, sofa, desk, breakfast table, countertop; roles/candidates.csv kind scene). Three recorded stances: init A, manipulation B,
    ; placement C.

    (:objects
        pillow.n.01_1 - pillow.n.01
        bed.n.01_1 bed.n.01_2 - bed.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop pillow.n.01_1 bed.n.01_2)
        (not (ontop pillow.n.01_1 bed.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?pillow.n.01_1 ?bed.n.01_1)
            (not (grasped ?agent.n.01_1 ?pillow.n.01_1))
            (pose_settled ?pillow.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?pillow.n.01_1)
    )
)

(define (problem inter_object_relation_satisfaction-83)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-nextto_small_scale-gym_shoe-gym_shoe-hall_tree_inside)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-nextto_small_scale-gym_shoe-gym_shoe-hall_tree_inside (inter_object_relation_satisfaction/nextto_small_scale.iddl; inter_object_relation_satisfaction-nextto#04~T1/representative)
    ; IORS - nextto (small-scale). Target and partner on the support with an init gap above the NextTo bound; the target is moved to the
    ; nearest position that satisfies NextTo (gap below mean(dims_a + dims_b)/6, adjacency rays), same orientation.

    (:objects
        gym_shoe.n.01_1 gym_shoe.n.01_2 - gym_shoe.n.01
        hallstand.n.01_1 - hallstand.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inside gym_shoe.n.01_1 hallstand.n.01_1)
        (inside gym_shoe.n.01_2 hallstand.n.01_1)
        (not (nextto gym_shoe.n.01_1 gym_shoe.n.01_2))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (nextto ?gym_shoe.n.01_1 ?gym_shoe.n.01_2)
            (not (grasped ?agent.n.01_1 ?gym_shoe.n.01_1))
            (not (grasped ?agent.n.01_1 ?gym_shoe.n.01_2))
            (pose_settled ?gym_shoe.n.01_1)
            (pose_settled ?gym_shoe.n.01_2)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?gym_shoe.n.01_1)
        (pose_reached ?gym_shoe.n.01_2)
    )
)

(define (problem inter_object_relation_satisfaction-45)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-nextto-pencil-ruler-countertop)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-nextto-pencil-ruler-countertop (inter_object_relation_satisfaction/nextto.iddl; inter_object_relation_satisfaction-nextto#01~T2/representative)
    ; IORS - nextto. Target and partner on the support with an init gap above the NextTo bound; the target is moved to the
    ; nearest position that satisfies NextTo (gap below mean(dims_a + dims_b)/6, adjacency rays), same orientation.

    (:objects
        pencil.n.01_1 - pencil.n.01
        rule.n.12_1 - rule.n.12
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop pencil.n.01_1 countertop.n.01_1)
        (ontop rule.n.12_1 countertop.n.01_1)
        (not (nextto pencil.n.01_1 rule.n.12_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (nextto ?pencil.n.01_1 ?rule.n.12_1)
            (not (grasped ?agent.n.01_1 ?pencil.n.01_1))
            (not (grasped ?agent.n.01_1 ?rule.n.12_1))
            (pose_settled ?pencil.n.01_1)
            (pose_settled ?rule.n.12_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?pencil.n.01_1)
        (pose_reached ?rule.n.12_1)
    )
)

(define (problem inter_object_relation_satisfaction-114)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-ontop_large_scale-mouse-desk-floor)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-ontop_large_scale-mouse-desk-floor (inter_object_relation_satisfaction/ontop_large_scale.iddl; inter_object_relation_satisfaction-ontop_large_scale#02/representative)
    ; owner 2026-10-12 ~15:55 iors_large inter_object_relation_satisfaction-ontop_large_scale#02 c1: hand-made from this grounding - mouse/pljjtu onto desk_iotfzl_0 from the floor of living_room_0; registry mode test
    ; IORS - ontop (large-scale). The target starts on a support (a table within 3 m of the partner, or the floor beside it -
    ; an explicit support choice made by ground_isg, never a runtime fallback) and ends on top of a large scene partner
    ; (bed, sofa, desk, breakfast table, countertop; roles/candidates.csv kind scene). Three recorded stances: init A, manipulation B,
    ; placement C.

    (:objects
        mouse.n.04_1 - mouse.n.04
        desk.n.01_1 - desk.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop mouse.n.04_1 floor.n.01_1)
        (not (ontop mouse.n.04_1 desk.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?mouse.n.04_1 ?desk.n.01_1)
            (not (grasped ?agent.n.01_1 ?mouse.n.04_1))
            (pose_settled ?mouse.n.04_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?mouse.n.04_1)
    )
)

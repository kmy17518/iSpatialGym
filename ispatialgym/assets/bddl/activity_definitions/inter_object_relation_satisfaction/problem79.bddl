(define (problem inter_object_relation_satisfaction-79)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-under_large_scale-apple-desk-desk)

    ; ground_isg 2.0.0 2026-09-16: inter_object_relation_satisfaction-under_large_scale-apple-desk-desk (inter_object_relation_satisfaction/under_large_scale.iddl; inter_object_relation_satisfaction-under_large_scale#05/representative)
    ; IORS - under (large-scale). The target starts on a support (a table near the partner, the floor beside it, or the
    ; partner's own top) and ends on the floor under a large scene partner (bed, sofa, desk, breakfast table; roles/candidates.csv
    ; kind scene) at a goal cell where an upward ray hits the partner above target height + 3 cm. Argument order: the
    ; target is under the partner. When partner and support are the same scene object the BDDL declares it once.

    (:objects
        apple.n.01_1 - apple.n.01
        desk.n.01_1 - desk.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop apple.n.01_1 desk.n.01_1)
        (not (under apple.n.01_1 desk.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (under ?apple.n.01_1 ?desk.n.01_1)
            (not (grasped ?agent.n.01_1 ?apple.n.01_1))
            (pose_settled ?apple.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?apple.n.01_1)
    )
)

(define (problem inter_object_relation_satisfaction-57)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-ontop_large_scale-beaker-bed-floor)

    ; ground_isg 2.0.0: inter_object_relation_satisfaction-ontop_large_scale-beaker-bed-floor (inter_object_relation_satisfaction/ontop_large_scale.iddl; inter_object_relation_satisfaction-ontop_large_scale#05/representative/fallback1:init_surface)
    ; fallback 1 (init_surface) of inter_object_relation_satisfaction-ontop_large_scale-beaker-bed-desk: init_surface = floor
    ; IORS - ontop (large-scale). The target starts on a support (a table within 3 m of the partner, or the floor beside it -
    ; an explicit support choice made by ground_isg, never a runtime fallback) and ends on top of a large scene partner
    ; (bed, sofa, desk, breakfast table, countertop; roles/candidates.csv kind scene). Three recorded stances: init A, manipulation B,
    ; placement C.

    (:objects
        beaker.n.02_1 - beaker.n.02
        bed.n.01_1 - bed.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop beaker.n.02_1 floor.n.01_1)
        (not (ontop beaker.n.02_1 bed.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?beaker.n.02_1 ?bed.n.01_1)
            (not (grasped ?agent.n.01_1 ?beaker.n.02_1))
            (pose_settled ?beaker.n.02_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?beaker.n.02_1)
    )
)

(define (problem inter_object_relation_satisfaction-67)
    (:domain ispatialgym)
    (:alias inter_object_relation_satisfaction-ontop_small_scale-half_bagel-plate-conference_table)

    ; ground_isg 2.0.0 2026-09-16: inter_object_relation_satisfaction-ontop_small_scale-half_bagel-plate-conference_table (inter_object_relation_satisfaction/ontop_small_scale.iddl; inter_object_relation_satisfaction-ontop_small_scale#05~T3/representative)
    ; IORS - ontop (small-scale). Target and partner both on the support; the target ends centred on top of the partner with
    ; its init orientation; the partner stays where it was. Both poses measured.

    (:objects
        half__bagel.n.01_1 - half__bagel.n.01
        plate.n.04_1 - plate.n.04
        conference_table.n.01_1 - conference_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop half__bagel.n.01_1 conference_table.n.01_1)
        (ontop plate.n.04_1 conference_table.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?half__bagel.n.01_1 ?plate.n.04_1)
            (not (grasped ?agent.n.01_1 ?half__bagel.n.01_1))
            (not (grasped ?agent.n.01_1 ?plate.n.04_1))
            (pose_settled ?half__bagel.n.01_1)
            (pose_settled ?plate.n.04_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?half__bagel.n.01_1)
        (pose_reached ?plate.n.04_1)
    )
)

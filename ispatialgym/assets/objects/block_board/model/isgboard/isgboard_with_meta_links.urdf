<?xml version="1.0" ?>
<robot name="isgboard">
    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0.013" rpy="0 0 0" />
            <mass value="1.5" />
            <inertia ixx="0.00111508" ixy="0" ixz="0" iyy="0.00111508" iyz="0" izz="0.00206116" />
        </inertial>
        <visual name="visual">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="meshes/visual.obj" scale="1 1 1" />
            </geometry>
        </visual>
        <collision name="plate">

; IORS - nextto (large-scale). The target is a floor-standing spawned object (its support is the floor) and ends next to a
; large scene partner (ontop_large_scale with the goal predicate nextto). No grasp: the robot pushes the target across the
; floor by driving the base with the closed hand on it (oracle base_push), so no library grasps are required.
(define (iddl inter_object_relation_satisfaction-nextto_large_scale)
    (:family inter_object_relation_satisfaction)
    (:alias inter_object_relation_satisfaction-nextto_large_scale-{target}-{partner}-{support})
    (:init
        (ontop target support)
        (not (nextto target partner))
        (ontop agent floor)
    )
    (:goal
        (and
            (nextto ?target ?partner)
            (not (grasped ?agent ?target))
            (pose_settled ?target)
            (pose_settled ?agent)
        )
    )
    (:measure
        (pose_reached ?target)
    )
)

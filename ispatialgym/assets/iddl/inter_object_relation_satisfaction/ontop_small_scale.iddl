; IORS - ontop (small-scale). Target and partner both on the support; the target ends centred on top of the partner with
; its init orientation; the partner stays where it was. Both poses measured.
(define (iddl inter_object_relation_satisfaction-ontop_small_scale)
    (:family inter_object_relation_satisfaction)
    (:alias inter_object_relation_satisfaction-ontop_small_scale-{target}-{partner}-{support})
    (:roles
        target - object
        partner - object
        support - fixed
        floor - fixed
        agent - agent
    )
    (:options
        (grasps target tabletop)
        (scene support breakfast_table desk countertop bar bottom_cabinet coffee_table conference_table pedestal_table booth shelf)
        (scene floor floors)
    )
    (:init
        (ontop target support)
        (ontop partner support)
        (ontop agent floor)
    )
    (:goal
        (and
            (ontop ?target ?partner)
            (not (grasped ?agent ?target))
            (not (grasped ?agent ?partner))
            (pose_settled ?target)
            (pose_settled ?partner)
            (pose_settled ?agent)
        )
    )
    (:measure
        (pose_reached ?target)
        (pose_reached ?partner)
    )
)

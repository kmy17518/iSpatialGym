; IORS - inside (small-scale). Target lowered into the partner (fillable container) on the support; the target's goal orientation is
; whatever settles (TRO orientation_metric null), which also admits flowers stood in vases. Both poses measured. The
; insert grasp pipeline (pads on the upper part of the object so the lower body can enter the container; flowers held
; by the upper stem) is required.
(define (iddl inter_object_relation_satisfaction-inside_small_scale)
    (:family inter_object_relation_satisfaction)
    (:variant inter_object_relation_satisfaction-inside_small_scale-{target}-{partner}-{support})
    (:require
        (grasps target insert)
    )
    (:init
        (ontop target support)
        (ontop partner support)
        (not (inside target partner))
        (ontop agent floor)
    )
    (:goal
        (and
            (inside ?target ?partner)
            (not (grasped ?agent ?target))
            (not (grasped ?agent ?partner))
            (pose_settled ?target)
            (pose_settled ?partner)
            (pose_settled ?agent)
        )
    )
    (:measure
        (pose_reached ?target)
        (pose_reached ?partner)
    )
)

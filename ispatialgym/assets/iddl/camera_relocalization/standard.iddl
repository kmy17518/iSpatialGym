; Camera relocalization - standard. Navigate from a random init pose to the base / trunk configuration whose head-camera
; pose is the goal (goal image). No manipulated object. Path length buckets (MAX LENGTH 3 / 5 / 10 m) are a generation
; parameter of the customs list (generation.path_buckets), not part of the alias.
(define (iddl camera_relocalization-standard)
    (:family camera_relocalization)
    (:alias camera_relocalization-standard)
    (:roles
        floor - fixed
        agent - agent
    )
    (:options
        (scene floor floors)
    )
    (:init
        (ontop agent floor)
    )
    (:goal
        (and
            (pose_reached ?agent)
            (pose_settled ?agent)
        )
    )
)

; Disembedding. Target and distractors on the source tray, destination tray beside it on the support; the target ends on
; the destination tray (centre, init orientation), no distractor does. Distractor categories / counts come from the icl
; pools (same-category / other-category) and are part of the alias (e.g. bottle_of_beer_3_bottle_of_sake_1). Trays are
; fixed models for now (tray gsxbym source, tray hvlfig destination).
(define (iddl disembedding)
    (:family disembedding)
    (:alias disembedding-{target}-{distractors}-{support})
    (:roles
        target - object
        distractors - group
        source - object
        destination - object
        support - fixed
        floor - fixed
        agent - agent
    )
    (:options
        (grasps target tabletop)
        (group_size distractors 1 3)
        (scene support breakfast_table desk countertop bar bottom_cabinet coffee_table conference_table pedestal_table booth shelf)
        (scene floor floors)
    )
    (:init
        (ontop source support)
        (ontop destination support)
        (ontop target source)
        (ontop distractors source)
        (not (ontop target destination))
        (not (ontop distractors destination))
        (ontop agent floor)
    )
    (:goal
        (and
            (ontop ?target ?destination)
            (not (ontop ?distractors ?destination))
            (not (grasped ?agent ?target))
            (pose_settled ?target)
            (pose_settled ?agent)
        )
    )
    (:measure
        (pose_reached ?target)
    )
)

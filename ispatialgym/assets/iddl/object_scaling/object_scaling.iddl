; Object scaling. The target is held (right arm, fixed hold pose) at init and at the goal; the goal is a depth change of
; the target along the head-camera optical axis (TRO pose target: frame = head camera, position_metric = depth).
(define (iddl object_scaling)
    (:family object_scaling)
    (:alias object_scaling-{target})
    (:roles
        target - object
        floor - fixed
        agent - agent
    )
    (:options
        (grasps target floating)
        (scene floor floors)
    )
    (:init
        (ontop agent floor)
        (grasped agent target)
    )
    (:goal
        (and
            (grasped ?agent ?target)
            (pose_reached ?target)
            (pose_settled ?target)
            (pose_settled ?agent)
        )
    )
)

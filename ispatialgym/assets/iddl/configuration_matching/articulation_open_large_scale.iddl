; Configuration matching - articulation (large-scale, open). The target is a scene articulated object (cabinet, fridge,
; oven, drawer, door) bound per scene; one joint is chosen; closed -> open to a passively stable angle q_goal in S.
; Handle grasp with the arm on the handle's side; opening primarily by base / trunk motion (base-follow), arm secondary.
(define (iddl configuration_matching-articulation_open_large_scale)
    (:family configuration_matching)
    (:alias configuration_matching-articulation_open_large_scale-{target})
    (:roles
        target - fixed
        floor - fixed
        agent - agent
    )
    (:options
        (articulated target)
        (scene target bottom_cabinet bottom_cabinet_no_top top_cabinet fridge oven dishwasher door)
        (scene floor floors)
    )
    (:init
        (not (open target))
        (ontop agent floor)
    )
    (:goal
        (and
            (open ?target)
            (layout_reached ?target)
            (not (grasped ?agent ?target))
            (pose_settled ?target)
            (pose_settled ?agent)
        )
    )
)

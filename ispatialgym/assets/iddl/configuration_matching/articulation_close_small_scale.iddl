; Configuration matching - articulation (small-scale, close). Spawned articulated object on the support, one joint open
; at q_init in S -> closed limit. Handle arm + brace arm (brace computed geometrically); joint configuration and root pose
; measured. Joint from the customs list (roles.target.joint / handle_key).
(define (iddl configuration_matching-articulation_close_small_scale)
    (:family configuration_matching)
    (:variant configuration_matching-articulation_close_small_scale-{target}-{support})
    (:require
        (handle target)
    )
    (:init
        (open target)
        (ontop target support)
        (ontop agent floor)
    )
    (:goal
        (and
            (not (open ?target))
            (ontop ?target ?support)
            (not (grasped ?agent ?target))
            (pose_settled ?target)
            (pose_settled ?agent)
        )
    )
    (:measure
        (pose_reached ?target)
        (layout_reached ?target)
    )
)

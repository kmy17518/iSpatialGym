; Configuration matching - articulation (small-scale, open). Spawned articulated object (toolbox, carton, hinged jar) on
; the support (floor for objects taller than 0.6 m), facing the robot; closed -> open to q_goal in S. Handle arm + brace
; arm on the base link (brace computed geometrically); the joint configuration (layout_reached) and the object's root pose
; (pose_reached) are measured, not gated. Joint from the customs list (roles.target.joint / handle_key).
(define (iddl configuration_matching-articulation_open_small_scale)
    (:family configuration_matching)
    (:variant configuration_matching-articulation_open_small_scale-{target}-{support})
    (:require
        (handle target)
    )
    (:init
        (not (open target))
        (ontop target support)
        (ontop agent floor)
    )
    (:goal
        (and
            (open ?target)
            (ontop ?target ?support)
            (not (grasped ?agent ?target))
            (pose_settled ?target)
            (pose_settled ?agent)
        )
    )
    (:measure
        (pose_reached ?target)
        (layout_reached ?target)
    )
)

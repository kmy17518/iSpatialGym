; Configuration matching - articulation (large-scale, close). Scene articulated object (roles.csv kind scene, bound per
; scene; joint from the customs list roles.target.joint / handle_key), one joint open at q_init in S (must satisfy Open)
; -> closed limit. Handle grasp in this direction too; base / trunk primary, arm secondary.
(define (iddl configuration_matching-articulation_close_large_scale)
    (:family configuration_matching)
    (:alias configuration_matching-articulation_close_large_scale-{target})
    (:require
        (handle target)
    )
    (:init
        (open target)
        (ontop agent floor)
    )
    (:goal
        (and
            (not (open ?target))
            (layout_reached ?target)
            (not (grasped ?agent ?target))
            (pose_settled ?target)
            (pose_settled ?agent)
        )
    )
)

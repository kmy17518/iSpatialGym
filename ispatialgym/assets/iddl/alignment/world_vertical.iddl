; Alignment - world vertical. The target hangs on the support (a wall) through a revolute hinge at its centre of mass
; (axis = wall normal, TRO constraint), starts tilted 15-45 deg in the wall plane and must be pushed upright (tangential
; push at the low end + brace at the high end). Orientation-only target; the position is fixed by the hinge.
(define (iddl alignment-world_vertical)
    (:family alignment)
    (:alias alignment-world_vertical-{target}-{support})
    (:roles
        target - object
        support - fixed
        floor - fixed
        agent - agent
    )
    (:options
        (push target)
        (hinge target support normal)
        (scale target configured)
        (scene support walls)
        (scene floor floors)
    )
    (:init
        (ontop agent floor)
    )
    (:goal
        (and
            (pose_reached ?target)
            (not (grasped ?agent ?target))
            (pose_settled ?target)
            (pose_settled ?agent)
        )
    )
)

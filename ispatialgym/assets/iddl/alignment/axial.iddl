; Alignment - axial (former world_alignment-0 / table_surface). The target rests on the support with a vertical hinge
; through its centre of mass (TRO constraint, parent = support); it starts yawed 20-70 deg off and is pushed at one end
; (right hand) while the other gripper braces the stop edge, until its long axis is aligned with the support edges and
; its front faces the robot. Orientation-only target.
(define (iddl alignment-axial)
    (:family alignment)
    (:alias alignment-axial-{target}-{support})
    (:roles
        target - object
        support - fixed
        floor - fixed
        agent - agent
    )
    (:options
        (push target)
        (hinge target support vertical)
        (scale target configured)
        (scene support breakfast_table desk countertop bar bottom_cabinet coffee_table conference_table pedestal_table booth shelf)
        (scene floor floors)
    )
    (:init
        (ontop target support)
        (ontop agent floor)
    )
    (:goal
        (and
            (ontop ?target ?support)
            (pose_reached ?target)
            (not (grasped ?agent ?target))
            (pose_settled ?target)
            (pose_settled ?agent)
        )
    )
)

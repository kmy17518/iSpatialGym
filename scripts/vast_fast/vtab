#!/usr/bin/env python3
"""i7-vast: GPU-h of a tag's Vast jobs (tab_i.py takes GPU-h from sacct, which has no Vast job: read its att / wr / ok there, the GPU-h
here). Per job dir with a backend.json: the job script's wall time on its GPU (= what sacct's ElapsedRaw is for a slurm job), the
GPU model, the instance price share ($/h x wall / jobs sharing the instance).
    $OFH/vast/tool/vtab <tag> [tag ...]        (roots: $OFH/out)"""
import collections
import glob
import json
import os
import sys

OUT = "/vision/u/minyeong/projects/isg_home/oracle_fix/out"
for tag in sys.argv[1:]:
    tot = collections.Counter()
    gpus = collections.Counter()
    for d in sorted(glob.glob(f"{OUT}/{tag}/*/g*")):
        b = os.path.join(d, "backend.json")
        if not os.path.exists(b):
            continue
        bk = json.load(open(b))
        st = json.load(open(os.path.join(d, "job_stats.json"))) if os.path.exists(os.path.join(d, "job_stats.json")) else {}
        el = float(bk.get("elapsed_s") or 0)
        usd = el / 3600 * float(bk.get("dph") or 0) / max(1, int(bk.get("slots") or 1))
        tot.update(jobs=1, s=el, usd=usd, att=st.get("attempts") or 0, wr=st.get("written") or 0, ok=st.get("successes") or 0)
        gpus[bk.get("gpu")] += 1
        print(f"  {d.split('/out/')[-1]:70s} {bk.get('gpu')} wall {el / 60:5.1f} min att {st.get('attempts')} wr {st.get('written')} ok {st.get('successes')} ${usd:.3f}")
    g = tot["s"] / 3600
    print(f"== {tag}: vast jobs {tot['jobs']} ({dict(gpus)}) att {tot['att']} wr {tot['wr']} ok {tot['ok']} | GPU-h {g:.2f}"
          + (f" = {g / tot['ok']:.3f}/success, ${tot['usd'] / tot['ok']:.3f}/success" if tot["ok"] else "") + f" | ${tot['usd']:.2f} (job time only)")

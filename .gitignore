# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Environment / secrets
.env
*.local

# OS / editor
.DS_Store
.idea/
.vscode/

# Logs / caches
*.log
.cache/
.pytest_cache/

# Separate nested repo (kmy17518/BEHAVIOR-1K fork, branch `ispatialgym`; cloned by setup.sh)
Behavior-1K/

# Separate nested repo (project website), not part of this package
ispatialgym/behavior-vision-suite.github.io/

# Lab evaluation (lab_tools/): its records (lab/, mirrored to the coordination repo on the Hub), the ACT checkout with its
# venv and checkpoints (act-isg/), the cluster sanity battery's outputs (sanity/)
/lab/
/act-isg/
/sanity/

# Generated task instances (ispatialgym.sampling default output, repo-root datasets/ only) and sampler probes
/datasets/
# run_isg runs of eval dataset instances (default --out ./runs)
/runs/
sampling_report_*.json
validation_report_*.json

# Run logs: keep the small data the sampler reads (grasp library yaml/json, selection csv/json, scripts, notes)
# but not the rendered frames / strips / videos (GBs of images).
runlogs/**/*.png
runlogs/**/*.jpg
runlogs/**/*.jpeg
runlogs/**/*.gif
runlogs/**/*.mp4
runlogs/**/*.webm
runlogs/**/*.npy
runlogs/**/*.npz
runlogs/**/*.pt
runlogs/**/*.pth
runlogs/**/*.pkl
runlogs/**/*.usd
runlogs/**/*.usda
runlogs/**/*.usdc

# RunPod fleet state (pod ids, billing samples, benchmark pulls)
runlogs/runpod/

# scene inventory renders (review material, regenerable with --parts renders)
runlogs/scene_inventory_*/**/renders/
runlogs/scene_inventory_*/**/strips/
# symmetry survey contact sheets: small JPEGs (<= 100 KB each) kept for the review round
!runlogs/symmetry_*/renders/*.jpg
runlogs/smoke_inputs/
